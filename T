local function refreshMusicState()
    if not BgSound then return end
    State.musicOn = BgSound.Playing
    PlayBtn.Text = State.musicOn and "⏸" or "▶"
end

local function changeTrack(newIndex)
    if newIndex < 1 then newIndex = #Playlist end
    if newIndex > #Playlist then newIndex = 1 end
    State.currentTrack = newIndex
    local wasPlaying = State.musicOn
    BgSound = createSound(State.currentTrack)
    if wasPlaying and BgSound then
        pcall(function() BgSound:Resume() end)
    else
        pcall(function() if BgSound then BgSound:Pause() end end)
    end
    NowPlaying.Text = "🎵 " .. Playlist[State.currentTrack].name
    notify("Now Playing", Playlist[State.currentTrack].name)
    refreshMusicState()
end

