DragArea.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        State.dragStart = input.Position
        State.startPos = Main.Position
        State.isDragging = true
    end
end)

track(UIS.InputChanged, function(input)
    if not State.isDragging or not State.dragStart then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local delta = input.Position - State.dragStart
    Main.Position = UDim2.new(
        State.startPos.X.Scale, State.startPos.X.Offset + delta.X,
        State.startPos.Y.Scale, State.startPos.Y.Offset + delta.Y
    )
end)

track(UIS.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        State.dragStart = nil
        State.isDragging = false
    end
end)

