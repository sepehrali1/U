    iconBox.Position = UDim2.new(0.5, -18, 0, 10)
    iconBox.BackgroundColor3 = C.blood
    iconBox.BackgroundTransparency = 0.2
    iconBox.ZIndex = 13
    iconBox.Parent = tile
    corner(iconBox, 8)

    local iconLbl = Instance.new("TextLabel")
    iconLbl.Size = UDim2.new(1, 0, 1, 0)
    iconLbl.BackgroundTransparency = 1
    iconLbl.Font = Enum.Font.Code
    iconLbl.TextSize = 16
    iconLbl.TextColor3 = C.white
    iconLbl.ZIndex = 14
    iconLbl.Parent = iconBox

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size = UDim2.new(1, -8, 0, 28)
    nameLbl.Position = UDim2.new(0, 4, 0, 50)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Font = Enum.Font.Code
    nameLbl.TextSize = 10
    nameLbl.TextColor3 = C.text
    nameLbl.TextWrapped = true
    nameLbl.TextXAlignment = Enum.TextXAlignment.Center
    nameLbl.ZIndex = 13
    nameLbl.Parent = tile

    local hit = Instance.new("TextButton")
    hit.Size = UDim2.new(1, 0, 1, 0)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.AutoButtonColor = false
    hit.ZIndex = 20
    hit.Parent = tile

    hit.MouseEnter:Connect(function()
        tween(tile, TweenInfo.new(0.15), {BackgroundTransparency = 0.05})
        tween(ts, TweenInfo.new(0.15), {Transparency = 0.1})
    end)
    hit.MouseLeave:Connect(function()
        tween(tile, TweenInfo.new(0.15), {BackgroundTransparency = 0.25})
        tween(ts, TweenInfo.new(0.15), {Transparency = 0.65})
    end)
    hit.InputBegan:Connect(function(i) if isPress(i) then tween(scale, TweenInfo.new(0.1), {Scale = 0.93}) end end)
    hit.InputEnded:Connect(function(i) if isPress(i) then tween(scale, TweenInfo.new(0.2, EASE2), {Scale = 1}) end end)

    local currentEntry = nil
    hit.MouseButton1Click:Connect(function()
        if currentEntry and runEntry then
            runEntry(currentEntry)
        end
    end)

    local ref = {
        tile = tile,
        iconLbl = iconLbl,
        nameLbl = nameLbl,
        ts = ts,
        scale = scale,
        setEntry = function(e) currentEntry = e end,
    }

    table.insert(tilePool, ref)
    return ref
end

refreshTiles = function()
    local q = string.lower(SearchBox.Text)
    local visibleEntries = {}
    for _, e in ipairs(entries) do
        local catOk = (State.currentCat == "All") or (e.cat == State.currentCat)
        local searchOk = (q == "") or string.find(string.lower(e.name), q, 1, true)
        if catOk and searchOk then
            table.insert(visibleEntries, e)
        end
    end

    for i, e in ipairs(visibleEntries) do
        local ref
        if tilePool[i] then
            ref = tilePool[i]
        else
            ref = makeTile()
        end
        ref.tile.Visible = true
        ref.tile.LayoutOrder = i
        ref.iconLbl.Text = string.sub(e.name, 1, 1):upper()
        ref.nameLbl.Text = e.name
        ref.setEntry(e)
    end

    for i = #visibleEntries + 1, #tilePool do
        if tilePool[i] and tilePool[i].tile then
            tilePool[i].tile.Visible = false
        end
    end

    EmptyLabel.Text = (#visibleEntries == 0) and "No results found" or ""
end

local function scheduleRefresh()
    if State.refreshQueued then return end
    State.refreshQueued = true
    task.delay(0.15, function() 
        State.refreshQueued = false
        if not State.destroyed and refreshTiles then refreshTiles() end
    end)
end

