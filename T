local function createSound(trackIndex)
    local old = SoundService:FindFirstChild("SskidMusic")
    if old then pcall(function() old:Destroy() end) end
    local track = Playlist[trackIndex]
    if not track then return nil end
    local s = Instance.new("Sound")
    s.Name = "SskidMusic"
    s.SoundId = "rbxassetid://" .. track.id
    s.Volume = 0
    s.Looped = true
    s.Parent = SoundService
    pcall(function() s:Play() end)
    tween(s, TweenInfo.new(1.5), {Volume = State.musicVolume})
    return s
end

