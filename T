local function updateSeekVisual()
    if not BgSound or BgSound.TimeLength <= 0 then return end
    local a = math.clamp(BgSound.TimePosition / BgSound.TimeLength, 0, 1)
    if not State.seeking then
        SeekFill.Size = UDim2.new(a, 0, 1, 0)
        SeekKnob.Position = UDim2.new(a, 0, 0.5, 0)
    end
    local function fmt(sec) return string.format("%d:%02d", math.floor(sec / 60), math.floor(sec % 60)) end
    TimeLbl.Text = fmt(BgSound.TimePosition) .. " / " .. fmt(BgSound.TimeLength)
