local camera = workspace.CurrentCamera
local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
local function refreshViewport() if camera then viewport = camera.ViewportSize end end

local function calcDimensions()
    refreshViewport()
    local w, h
    if viewport.X < 500 then
        w = math.min(viewport.X - 16, 340); h = math.min(viewport.Y - 100, viewport.Y * 0.82)
    elseif viewport.X < 800 then
        w = math.min(viewport.X * 0.9, 400); h = math.min(viewport.Y * 0.8, 480)
    elseif viewport.X < 1200 then
        w = math.min(viewport.X * 0.58, 480); h = math.min(viewport.Y * 0.75, 460)
    else
        w = math.min(viewport.X * 0.46, 560); h = math.min(viewport.Y * 0.75, 500)
    end
    return w, h
end

local function calcUIScale()
    refreshViewport()
    if viewport.X < 500 then return 0.82
    elseif viewport.X < 800 then return 0.92
    else return 1 end
end

State.panelW, State.panelH = calcDimensions()
