end

local function minimizePanel()
    if State.isMinimized or not Main.Visible then return end
    State.isMinimized = true
    -- [+] باگ 6 Fix: همیشه اندازه فعلی رو ذخیره کن
    State.savedW = State.panelW
    State.savedH = State.panelH
    TBTitle.Text = "Sskid (minimized)"
    Sidebar.Visible = false
    Content.Visible = false
    tween(Main, TweenInfo.new(0.3, EASE), {Size = UDim2.new(0, 260, 0, 40)})
end

local function restorePanel()
    if not State.isMinimized then return end
    State.isMinimized = false
    TBTitle.Text = "Sskid Panel"
    tween(Main, TweenInfo.new(0.35, EASE2), {Size = UDim2.new(0, State.savedW, 0, State.savedH)})
    task.delay(0.35, function()
        if not State.isMinimized and Main.Visible then
            Sidebar.Visible = true
            Content.Visible = true
        end
    end)
end

local function togglePanel() 
    if not ready then return end
    if State.isMinimized then
        restorePanel()
    elseif Main.Visible then 
        closePanel() 
    else 
        openPanel() 
    end 
end

CloseBtn.MouseButton1Click:Connect(closePanel)
StartBtn.MouseButton1Click:Connect(togglePanel)
MinBtn.MouseButton1Click:Connect(minimizePanel)

track(UIS.InputBegan, function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then togglePanel() end
end)

